{
  "expo": {
    "name": "ExploreLanka",
    "slug": "ExploreLanka",
    "version": "1.0.0",
    "description": "An offline guide to Sri Lanka's most beautiful places.",
    "orientation": "portrait",
    "icon": "./assets/images/explorelanka-icon.png",
    "scheme": "explorelanka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/explorelanka-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#053F3A",
        "foregroundImage": "./assets/images/explorelanka-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/explorelanka-icon.png",
      "backgroundColor": "#F5F7FA"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#053F3A",
          "image": "./assets/images/explorelanka-icon.png",
          "imageWidth": 144
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
